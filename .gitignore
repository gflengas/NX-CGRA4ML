# =================================================================
# Existing Project Data Exclusions
# =================================================================
.DS_Store
# =================================================================
# General Cache and Temporary Files
# =================================================================
old/
__pycache__/
temp/
# This machine's tool locations (copy site.example.json)
/site.json
frontend/qonnx/vendor/
frontend/qonnx/out/

# =================================================================
# DeepSoCFlow / CGRA4ML Specific Files
# =================================================================
*.pickle
*.jou
*.log
*.h5
*.keras
CGRA4ML/deepsocflow/test/vectors/
CGRA4ML/deepsocflow/test/xsim/
CGRA4ML/deepsocflow/test/dnn_engine_tb.vcd
CGRA4ML/deepsocflow/test/xsc*
CGRA4ML/deepsocflow/test/obj_dir/
CGRA4ML/deepsocflow/test/models/
CGRA4ML/deepsocflow/test/temp/
CGRA4ML/deepsocflow/test/py/*
bsp_demo.dump
# =================================================================
# Run/Work Directory Rules
#
# Ignore generated run/work contents recursively.
# =================================================================
CGRA4ML/run/work/**

# Ignore other specific run directories by name
CGRA4ML/run/work_resnet/
CGRA4ML/run/work_temp/
CGRA4ML/run/work_ccd/
CGRA4ML/run/work_dddd/
CGRA4ML/run/work_llm/
CGRA4ML/run/work_example/
CGRA4ML/run/work_resnet18/
CGRA4ML/run/work_pointnet/

# Ignore ASIC simulation output, but keep reports
CGRA4ML/run/asic/*
!CGRA4ML/run/asic/reports/
!CGRA4ML/run/asic/reports/**

# =================================================================
# Build and Distribution Artifacts
# =================================================================
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# =================================================================
# Documentation
#
# Ignore all docs except the source ReStructuredText files and config
# =================================================================
CGRA4ML/docs/**
!CGRA4ML/docs/source/
!CGRA4ML/docs/source/**
!CGRA4ML/docs/source/conf.py
!CGRA4ML/docs/source/*.rst

# =================================================================
# IDE and Tooling Config
# =================================================================
.svls.toml
.svlint.toml
.vscode/
.codex
.codex/
